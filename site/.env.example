# Copy to .env.local and fill in. .env.local is gitignored; never commit the key.

# Resend API key for the support ticket form (/api/ticket).
RESEND_API_KEY=
# Where tickets land. Defaults to the published support address.
SUPPORT_EMAIL=
SUPPORT_FROM=

# The verified sender Resend accepts. Defaults to Resend's onboarding address,
# which only works for testing. Use a sender on your verified domain for real mail.
# SUPPORT_FROM=ThemeAves Support <support@themeaves.com>
